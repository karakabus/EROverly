{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ER Overlay",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "3210"
      },
      "serverReadyAction": {
        "pattern": "Control: (http://localhost:[0-9]+/control\\.html)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
